# ===========================================================================
# hoyo漫剧 · 环境变量样例
# 复制为 .env 后按需修改。所有数值都会被后端读取，前端不得写死。
# 未配置任何供应商密钥时，系统自动回退 Mock 供应商，闭环依然可以跑通。
# ===========================================================================

# --- 运行环境 ---
APP_ENV=dev
# 生产部署请务必替换（用于签名 URL 与密钥加密）
SECRET_KEY=dev-only-change-me-0123456789abcdef

# --- 数据库 ---
# 默认 SQLite（WAL）；并发写入增多时可换 postgresql+psycopg://user:pass@host:5432/hoyomanju
# 不填则用代码默认值（backend/data/hoyomanju.db 的绝对路径，跟着代码走，不会因启动目录变化）。
# 若要自己指定，务必写绝对路径 —— 相对路径会按「当前工作目录」解析，
# 从 backend/ 启动时会变成 backend/backend/data/... 并报 unable to open database file。
# DATABASE_URL=sqlite:///E:/hoyomanju/backend/data/hoyomanju.db
# LangGraph 人类门控 checkpoint（默认与数据同目录）
# CHECKPOINT_DB=backend/data/checkpoints.db

# --- 对象存储 ---
# local（默认，落盘到 STORAGE_DIR） | s3（MinIO / OSS / S3）
STORAGE_BACKEND=local
STORAGE_DIR=backend/data/storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=hoyomanju
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=1800

# --- 队列 / Worker ---
# 留空表示使用数据库租约队列（单机默认，无需 Redis）
REDIS_URL=
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL=0.4
WORKER_LEASE_SECONDS=120
AUTO_RETRY_LIMIT=1
# 自动重试的退避步长（秒）：第 n 次失败后退避 n × 该值；0 表示立即重试
RETRY_BACKOFF_SECONDS=5
# 非终态任务超过该秒数仍未完成 → EXPIRED；0 表示不启用
JOB_EXPIRE_SECONDS=86400
JOB_TIMEOUT_SECONDS=600
# 「短时间内的重复点击」去重窗口（秒）：同窗口内重复的生成请求命中同一个任务
IDEMPOTENCY_WINDOW_SECONDS=5

# --- 媒体 ---
# 留空则依次尝试 imageio-ffmpeg 内置二进制、PATH 中的 ffmpeg
FFMPEG_BIN=
PREVIEW_BITRATE_KBPS=800
EXPORT_VIDEO_BITRATE_KBPS=2500

# --- 配额与限制（前端通过 GET /api/v1/config/limits 读取） ---
QUOTA_LIMIT_CENTS=20000
MAX_CONCURRENT_JOBS=3
CANDIDATES_PER_SHOT_DEFAULT=2
CANDIDATES_PER_SHOT_MAX=4
SHOT_DURATION_MS_MIN=1000
SHOT_DURATION_MS_MAX=15000
EPISODE_DURATION_MS_MAX=600000
STORY_TEXT_MAX_CHARS=2000
MIN_SHOTS=6

# --- 供应商（各模态一个主供应商：mock / ark / openai / kling / minimax / deepseek / gemini / grok / qwen） ---
DEFAULT_PROVIDER=mock
TEXT_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
SPEECH_PROVIDER=mock
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=1
# 供应商出网代理（可选）：留空=跟随进程环境变量；
#   direct = 强制直连，忽略 IDE/沙箱注入的本地代理（它们常把境外请求变成 502）；
#   http://127.0.0.1:7890 = 显式指定代理
PROVIDER_PROXY_URL=
# 异步任务型供应商（toapis）的轮询间隔与总超时
TASK_POLL_INTERVAL_SECONDS=8
TASK_TIMEOUT_SECONDS=900

# 火山方舟（文本 / 图片 / 视频）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-1-6-250615
ARK_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528

# OpenAI 兼容
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# 可灵（视频）
KLING_API_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com

# MiniMax（语音）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_GROUP_ID=

# DeepSeek（文本，OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# toapis 网关（图片：异步任务）
# 国内直连用 https://toapis.cn（无需代理）；境外可用 https://toapis.com
# 注意：该网关的模型 id 区分大小写，必须用小写
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_URL=https://toapis.cn/v1/images/generations
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# 输出档位 1K / 2K / 4K（大写 K）；竖屏 9:16 想覆盖 1080×1920 建议 2K
GEMINI_IMAGE_RESOLUTION=2K

# toapis 网关（视频：异步任务）
# 图生视频：本地首帧会先 POST /v1/uploads/images 换公网 URL（网关不收 base64）
GROK_VIDEO_API_KEY=
GROK_VIDEO_URL=https://toapis.cn/v1/videos/generations
# grok-video-1.5（1~15s，video_generation_mode+image）
# 或 seedance-2-mini / seedance-2-fast / seedance-2（4~15s，image_with_roles）
TOAPIS_VIDEO_MODEL=seedance-2-mini
GROK_VIDEO_RESOLUTION=720p
# 上传接口地址；留空按提交地址同域自动推导（/v1/uploads/images）
TOAPIS_UPLOAD_URL=
# 网关账单是美元，内部按「分」记账时的折算汇率
USD_CNY_RATE=7.2

# 通义 MaaS（语音合成）
TTS_API_KEY=
TTS_URL=
TTS_API_MODEL=qwen-audio-3.1-tts-next
TTS_VOICE=Cherry

# --- 内容安全 ---
SAFETY_BLOCK_TERMS=儿童色情,恐怖主义宣传,制毒教程,煽动暴力,极端仇恨
AIGC_LABEL_TEXT=本内容由 AI 生成

# --- 门控策略 ---
# 视频生成前是否强制成本确认（需求 §12.3）
REQUIRE_VIDEO_COST_CONFIRMATION=true
# 是否启用 LangGraph 引擎（关闭后使用内置等价状态机，行为一致）
ENABLE_LANGGRAPH=true

# --- 前端（vite 构建期） ---
# 同源部署时留空；前后端分离时填后端地址
VITE_API_BASE=
